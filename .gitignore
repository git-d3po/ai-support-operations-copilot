# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database (deterministic seed script regenerates this — see prisma/seed.ts)
/dev.db
/dev.db-journal

# public-demo deployment database (npm run db:init:demo; see DECISIONS.md,
# "Public deployment: explicit Demo Mode and a guarded initialization") —
# regenerated by the deterministic seed on every start
/demo.db
/demo.db-journal

# live-evaluation database (see DECISIONS.md, "Live evaluation runs against a
# separate database") — holds real model results, never committed
/eval.db
/eval.db-journal

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
