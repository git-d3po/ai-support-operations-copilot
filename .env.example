# Copy to .env and fill in real values. Never commit .env.

# SQLite file used by Prisma. The default is fine for local development;
# the deterministic seed script (prisma/seed.ts) fully regenerates it.
DATABASE_URL="file:./dev.db"

# Anthropic API key used by the orchestrator and specialist agents.
# Required to run live AI analysis; not required to browse seeded data,
# run unit tests, or run Playwright tests against seeded fixtures.
ANTHROPIC_API_KEY=

# How "Run AI analysis" is answered. Unset (or "live") = the real model provider,
# which needs ANTHROPIC_API_KEY. "demo" = public Demo Mode: a deterministic replay
# of scripted responses for the curated scenarios only, with no model call and no
# API key (a key in the environment is ignored). Any other value is an error.
# A public deployment should set AI_MODE=demo and NOT set ANTHROPIC_API_KEY.
# Server-only: never expose this as a NEXT_PUBLIC_* variable.
AI_MODE=
