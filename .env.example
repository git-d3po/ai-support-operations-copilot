# Copy to .env and fill in real values. Never commit .env.

# SQLite file used by the app, the seed script and Prisma. The default is fine for
# local development; the deterministic seed script (prisma/seed.ts) fully regenerates it.
# The public deployment sets this explicitly (file:./demo.db) and its initialization
# (npm run db:init:demo) refuses evaluation databases; see README.md, "Replit deployment".
DATABASE_URL="file:./dev.db"

# Anthropic API key used by the orchestrator and specialist agents.
# LIVE / PRIVATE MODE ONLY: required to run live AI analysis and `npm run eval`. Not
# required to browse seeded data, run any automated test, or run Demo Mode.
# NEVER configure this on the public demo deployment (npm run start:demo blanks it
# in the server's environment regardless).
ANTHROPIC_API_KEY=

# How "Run AI analysis" is answered. Unset (or "live") = the real model provider,
# which needs ANTHROPIC_API_KEY. "demo" = public Demo Mode: a deterministic replay
# of scripted responses for the curated scenarios only, with no model call and no
# API key (a key in the environment is ignored). Any other value is an error.
# The public deployment's start command (npm run start:demo) sets AI_MODE=demo itself;
# you only set it by hand to try Demo Mode locally.
# Server-only: never expose this as a NEXT_PUBLIC_* variable.
AI_MODE=

# Where `npm run eval` writes live evaluation results. Defaults to file:./eval.db
# (repository root, gitignored) and is deliberately separate from DATABASE_URL: it
# holds real model results and must never be the demo or development database.
# Create it with `npm run db:eval:setup`. Leave unset unless you keep results elsewhere.
# EVAL_DATABASE_URL="file:./eval.db"
